rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isEmailAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'mourao.martins@gmail.com';
    }

    function isAdmin() {
      return isEmailAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Post Validation ---
    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'content', 'excerpt', 'authorId', 'authorName', 'published', 'createdAt', 'updatedAt', 'tags', 'imageUrl']) &&
             data.keys().size() == 10 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 50000 &&
             data.excerpt is string && data.excerpt.size() <= 500 &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.published is bool &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || data.tags[0] is string) &&
             data.imageUrl is string && data.imageUrl.size() <= 1000;
    }

    function isValidComment(data, postId) {
      return data.keys().hasAll(['postId', 'authorId', 'authorName', 'content', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.postId == postId &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 1000;
    }

    // --- Collections ---

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Only admins can manage other admins
    }

    match /blogPosts/{postId} {
      allow get: if existing().get('published', false) == true || isAdmin();
      allow list: if resource.data.get('published', false) == true || isAdmin();
      
      allow create: if isAdmin() && 
                    isValidId(postId) && 
                    isValidBlogPost(incoming()) && 
                    incoming().createdAt == request.time && 
                    incoming().updatedAt == request.time;
      
      allow update: if isAdmin() && 
                    isValidBlogPost(incoming()) && 
                    incoming().createdAt == existing().createdAt && 
                    incoming().updatedAt == request.time &&
                    incoming().authorId == existing().authorId;

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/blogPosts/$(postId)).data.published == true || isAdmin();
        allow create: if isSignedIn() && 
                      isValidComment(incoming(), postId) && 
                      incoming().createdAt == request.time &&
                      get(/databases/$(database)/documents/blogPosts/$(postId)).data.published == true;
        allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
      }
    }
  }
}
