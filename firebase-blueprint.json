{
  "entities": {
    "BlogPost": {
      "title": "Blog Post",
      "description": "A blog post about software development.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the post." },
        "content": { "type": "string", "description": "Markdown content of the post." },
        "excerpt": { "type": "string", "description": "A short summary of the post." },
        "authorId": { "type": "string", "description": "Firebase UID of the author." },
        "authorName": { "type": "string", "description": "Name of the author." },
        "published": { "type": "boolean", "description": "Whether the post is published." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Tags for the post." },
        "imageUrl": { "type": "string", "description": "Thumbnail image URL." }
      },
      "required": ["title", "content", "authorId", "authorName", "published", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "A user with administrative privileges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a blog post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/blogPosts/{postId}": {
      "schema": "BlogPost",
      "description": "Collection of blog posts."
    },
    "/blogPosts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Subcollection of comments for a specific post."
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Whitelist of admin users."
    }
  }
}
